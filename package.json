{
  "name": "g2-gmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gmail reader for Even Realities G2 smart glasses",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173",
    "qr": "npx evenhub qr",
    "pack": "npm run build && npx evenhub pack app.json ./dist --output g2-gmail.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.7",
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "@jappyjan/even-realities-ui": "^0.0.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
